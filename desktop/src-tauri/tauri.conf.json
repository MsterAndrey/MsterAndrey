{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NEXUS CUBE",
  "version": "0.1.0",
  "identifier": "co.com.nexuscube.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "NEXUS CUBE",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "NEXUS CUBE",
    "copyright": "© 2026 NEXUS CUBE",
    "category": "Utility",
    "shortDescription": "NEXUS CUBE Desktop (versión preliminar)",
    "longDescription": "Carpetas cifradas por cliente o caso, con llaves protegidas por el TPM 2.0 y confirmación con Windows Hello. Versión preliminar: usar sólo con archivos de prueba.",
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installMode": "perMachine",
        "languages": [
          "Spanish"
        ],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
